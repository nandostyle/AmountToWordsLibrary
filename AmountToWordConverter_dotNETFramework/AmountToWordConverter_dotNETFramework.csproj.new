	<TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
	<FileAlignment>512</FileAlignment>
	<Deterministic>true</Deterministic>
	<!-- NuGet Packaging Metadata -->
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageId>NandoStyle.AmountToWords</PackageId>
	<Title>Amount to Words Converter</Title>
	<Version>1.1.0.0</Version>
	<AssemblyVersion>1.1.0.0</AssemblyVersion>
	<FileVersion>1.1.0.0</FileVersion>
	<Authors>Fernando J. Garcia</Authors>
	<Description>A self-contained C#/.NET Framework 4.7.2 class library designed for easy integration into any .NET application. It converts decimal numbers into their word representation, handling multiple languages (English, Spanish) and currency formats (USD, MXN). Features include negative number support and plain number conversion mode.</Description>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<ProjectUrl>https://github.com/nandostyle/AmountToWordsLibrary</ProjectUrl>
	<RepositoryUrl>https://github.com/nandostyle/AmountToWordsLibrary</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageTags>amount;words;numbers;currency;conversion;spanish;english;i18n;localization</PackageTags>
	<PackageReleaseNotes>v1.1.0.0 - Added ConversionMode enum for currency and plain number modes. Added support for negative numbers with language-specific prefixes. Added plain number conversion with decimal point/comma representation based on language.</PackageReleaseNotes>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
	<DebugSymbols>true</DebugSymbols>
	<DebugType>full</DebugType>
	<Optimize>false</Optimize>
	<OutputPath>bin\Debug\</OutputPath>
	<DefineConstants>DEBUG;TRACE</DefineConstants>
	<ErrorReport>prompt</ErrorReport>
	<WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
	<DebugType>pdbonly</DebugType>
	<Optimize>true</Optimize>
	<OutputPath>bin\Release\</OutputPath>
	<DefineConstants>TRACE</DefineConstants>
