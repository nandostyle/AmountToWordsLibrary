<Window
    x:Class="NumberToWordsConverter_ApplicationExample.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:NumberToWordsConverter_ApplicationExample.ViewModels"
    Title="Amount to Words Converter Tester - .NET 6.0 or higher"
    Width="1000"
    Height="500"
    mc:Ignorable="d">
    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>
    <TabControl Margin="10" Padding="3">
        <TabItem Header="Amount to Words Converter">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Enter a number:" />
                    <TextBox
                        x:Name="InputNumberTextBox"
                        Width="250"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Text="{Binding InputNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Width="120"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <ComboBox
                        x:Name="CurrencyComboBox"
                        Width="120"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Currencies}"
                        SelectedValue="{Binding SelectedCurrency}"
                        SelectedValuePath="Value" />
                    <Button
                        x:Name="TestsButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF007ACC"
                        Command="{Binding ConvertCommand}"
                        Content="Run Test"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>
                <TextBox
                    x:Name="ResultsTextBox"
                    Grid.Row="2"
                    Height="Auto"
                    Margin="5"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    FontWeight="Bold"
                    IsReadOnly="True"
                    Text="{Binding Results, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

            </Grid>
        </TabItem>
        <TabItem Header="Tests">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        x:Name="AllTestsLanguageComboBox"
                        Width="120"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedTestLanguage}" />
                    <Button
                        x:Name="TestDollarsButton"
                        Margin="5"
                        Padding="10,5"
                        Command="{Binding TestDollarsCommand}"
                        Content="Test with Dollars" />
                    <Button
                        x:Name="TestPesosButton"
                        Margin="5"
                        Padding="10,5"
                        Command="{Binding TestPesosCommand}"
                        Content="Test with Pesos" />
                    <Button
                        x:Name="RunAllTestsButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF007ACC"
                        Command="{Binding RunAllTestsCommand}"
                        Content="Run All Tests"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>

                <TextBox
                    x:Name="AllTestResultsTextBox"
                    Grid.Row="2"
                    Margin="5"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    Text="{Binding AllTestResults, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
