<Window
    x:Class="NumberToWordsConverter_ApplicationExample.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:NumberToWordsConverter_ApplicationExample.ViewModels"
    Title="Amount to Words Converter Tester - .NET 6.0 or higher"
    Width="1100"
    Height="600"
    mc:Ignorable="d">
    <Window.DataContext>
        <viewModels:MainWindowViewModel />
    </Window.DataContext>
    <TabControl Margin="10" Padding="3">
        <TabItem Header="Amount to Words Converter">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  First row: Input  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Enter a number:" />
                    <TextBox
                        x:Name="InputNumberTextBox"
                        Width="250"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Text="{Binding InputNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Second row: Conversion Mode Selection  -->
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Conversion Mode:" />
                    <ComboBox
                        x:Name="ConversionModeComboBox"
                        Width="180"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding ConversionModes}"
                        SelectedValue="{Binding SelectedConversionMode}"
                        SelectedValuePath="Value" />
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Language:" />
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Width="120"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>

                <!--  Third row: Action buttons  -->
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ConvertButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF007ACC"
                        Command="{Binding ConvertCommand}"
                        Content="Convert"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        x:Name="ConvertPlainButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF28A745"
                        Command="{Binding ConvertPlainNumberCommand}"
                        Content="Convert as Plain"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        x:Name="ConvertNegativeButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FFDC3545"
                        Command="{Binding ConvertNegativeCommand}"
                        Content="Convert as Negative"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>

                <!--  Fourth row: Results  -->
                <TextBox
                    x:Name="ResultsTextBox"
                    Grid.Row="3"
                    Height="Auto"
                    Margin="5"
                    Padding="10"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Top"
                    FontFamily="Consolas"
                    FontSize="14"
                    FontWeight="Bold"
                    IsReadOnly="True"
                    Text="{Binding Results, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

            </Grid>
        </TabItem>
        <TabItem Header="Tests">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Currency Tests Row  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Test Language:" />
                    <ComboBox
                        x:Name="AllTestsLanguageComboBox"
                        Width="120"
                        Margin="5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedTestLanguage}" />
                    <Button
                        x:Name="TestDollarsButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF007ACC"
                        Command="{Binding TestDollarsCommand}"
                        Content="Test Dollars"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        x:Name="TestPesosButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF007ACC"
                        Command="{Binding TestPesosCommand}"
                        Content="Test Pesos"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>

                <!--  Plain Number & Negative Tests Row  -->
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="TestPlainNumbersButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF28A745"
                        Command="{Binding TestPlainNumbersCommand}"
                        Content="Test Plain Numbers"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        x:Name="TestNegativeButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FFDC3545"
                        Command="{Binding TestNegativeAmountsCommand}"
                        Content="Test Negative Amounts"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        x:Name="RunAllTestsButton"
                        Margin="5"
                        Padding="10,5"
                        Background="#FF6F42C1"
                        Command="{Binding RunAllTestsCommand}"
                        Content="Run All Tests"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>

                <!--  Results TextBox  -->
                <TextBox
                    x:Name="AllTestResultsTextBox"
                    Grid.Row="3"
                    Margin="5"
                    Padding="10"
                    FontFamily="Consolas"
                    FontSize="11"
                    IsReadOnly="True"
                    Text="{Binding AllTestResults, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
